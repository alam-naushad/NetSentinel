# ==============================================================================
# Environment Configuration Template — AI Network Anomaly Detection Platform
# Copy this file to .env and customize for your deployment environment.
# ==============================================================================

# Deployment Environment ('development', 'staging', 'production')
ENVIRONMENT=development

# Server Port and Host
HOST=0.0.0.0
PORT=8000

# Database Configuration
POSTGRES_DB=soc_telemetry
POSTGRES_USER=soc_user
POSTGRES_PASSWORD=soc_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database URLs
DATABASE_URL=postgresql+asyncpg://soc_user:soc_password@localhost:5432/soc_telemetry
DATABASE_SYNC_URL=postgresql+psycopg://soc_user:soc_password@localhost:5432/soc_telemetry
DATABASE_REQUIRED=false

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0

# CORS Allowed Origins (Comma-separated list, or '*' for local development only)
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000,http://127.0.0.1:5173

# Security & HTTPS Configuration
ENABLE_HTTPS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_INFERENCE_PER_MIN=60
RATE_LIMIT_UPLOAD_PER_MIN=20
# API_KEY=optional_secret_api_key_for_requests

# Logging Configuration ('console' for human-readable, 'json' for container collectors)
LOG_FORMAT=console
LOG_LEVEL=INFO

# Resource Upload Limits (Stage 6B validated default: 50MB)
PCAP_MAX_UPLOAD_SIZE_MB=50
PCAP_MAX_FLOWS=10000

# Zeek Ingestion Limits
ZEEK_MAX_UPLOAD_SIZE_MB=50
ZEEK_MAX_CONNECTIONS=100000

# Zeek Real-Time Spool Ingestion (Stage 9B)
ZEEK_SPOOL_ENABLED=false
ZEEK_SPOOL_DIR=/opt/zeek/spool/zeek
ZEEK_SPOOL_POLL_INTERVAL_SEC=1.0
ZEEK_SPOOL_FILE_PATTERN=conn*.log
ZEEK_QUEUE_MAX_SIZE=4096
ZEEK_BATCH_SIZE=50
ZEEK_BATCH_FLUSH_INTERVAL_SEC=2.0
ZEEK_DEDUP_CACHE_SIZE=10000

# Zeek SSE Streaming
ZEEK_SSE_MAX_CLIENTS=32
ZEEK_SSE_REPLAY_BUFFER_SIZE=256
ZEEK_SSE_HEARTBEAT_SEC=15.0

# Alert Policy Configuration
ALERT_RISK_THRESHOLD=65
ALERT_CONFIDENCE_THRESHOLD=0.80
ALERT_ON_UNKNOWN_ANOMALY=true
FEATURE_VECTOR_RETENTION_DAYS=90
